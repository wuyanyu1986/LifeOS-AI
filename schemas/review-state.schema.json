{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeos.local/schemas/review-state.schema.json",
  "title": "LifeOS Diary Review State",
  "type": "object",
  "required": [
    "entry_date",
    "parsed_note",
    "video_script",
    "wechat_article",
    "pipeline_status"
  ],
  "properties": {
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "pipeline_status": {
      "enum": [
        "parsed_pending_review",
        "parsed_changes_requested",
        "generating_derivatives",
        "derivatives_pending_review",
        "ready_for_manual_publish",
        "completed",
        "failed"
      ]
    },
    "parsed_note": {
      "$ref": "#/$defs/reviewableOutput"
    },
    "unabridged_parse": {
      "$ref": "#/$defs/sourceArchive"
    },
    "video_script": {
      "$ref": "#/$defs/reviewableOutput"
    },
    "wechat_article": {
      "$ref": "#/$defs/reviewableOutput"
    },
    "xiaohongshu_note": {
      "$ref": "#/$defs/reviewableOutput"
    },
    "douyin_script": {
      "$ref": "#/$defs/reviewableOutput"
    },
    "cover_assets": {
      "$ref": "#/$defs/coverAssets"
    }
  },
  "$defs": {
    "coverAssets": {
      "type": "object",
      "required": ["status", "revision", "notification_status"],
      "properties": {
        "status": {
          "enum": [
            "not_created",
            "briefing",
            "waiting_for_article",
            "generating",
            "archived",
            "superseded",
            "failed"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "source_article_revision": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "wiki_node_token": {
          "type": ["string", "null"]
        },
        "doc_token": {
          "type": ["string", "null"]
        },
        "master_path": {
          "type": ["string", "null"]
        },
        "xiaohongshu_path": {
          "type": ["string", "null"]
        },
        "wechat_wide_path": {
          "type": ["string", "null"]
        },
        "wechat_square_path": {
          "type": ["string", "null"]
        },
        "notification_status": {
          "enum": ["not_sent", "sent", "failed"]
        },
        "notification_message_id": {
          "type": ["string", "null"]
        },
        "last_error": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "reviewableOutput": {
      "type": "object",
      "required": ["status", "revision", "notification_status"],
      "properties": {
        "wiki_node_token": {
          "type": ["string", "null"]
        },
        "doc_token": {
          "type": ["string", "null"]
        },
        "status": {
          "enum": [
            "not_created",
            "pending_review",
            "approved",
            "changes_requested",
            "superseded"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "notification_status": {
          "enum": ["not_sent", "sent", "failed"]
        },
        "notification_message_id": {
          "type": ["string", "null"]
        },
        "reviewer_open_id": {
          "type": ["string", "null"]
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "review_comment": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "sourceArchive": {
      "type": "object",
      "required": ["file", "revision", "immutability"],
      "properties": {
        "file": {"type": "string"},
        "wiki_node_token": {"type": ["string", "null"]},
        "doc_token": {"type": ["string", "null"]},
        "revision": {"type": "integer", "minimum": 0},
        "immutability": {"const": "append-only"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
